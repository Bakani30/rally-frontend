EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_FUNCTION_REGION=ap-southeast-1
EXPO_PUBLIC_AUTH_REDIRECT_BASE_URL=
EXPO_PUBLIC_AUTH_REDIRECT_STRATEGY=custom-scheme
EXPO_PUBLIC_ENABLE_GOOGLE_AUTH=false

# Run tracking GPS engine. Leave as auto for normal dev:
# - simulator/emulator uses a deterministic mock route
# - physical devices use expo-location until field testing says otherwise
# Set to expo to force real location in simulator.
# mock is simulator/emulator only; physical devices ignore it by default.
EXPO_PUBLIC_ENABLE_RUNNING_GPS=false
EXPO_PUBLIC_RUN_LOCATION_PROVIDER=auto

# PostHog product analytics. User identity is resolved by the
# analytics-identity Edge Function; do not put analytics salts in the app.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
