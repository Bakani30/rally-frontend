{
  "name": "rally-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "eas-build-post-install": "cd .. && ln -sfn ../rally-app/node_modules/expo-router node_modules/expo-router && npx turbo run build --filter=@rally/contracts",
    "predev": "npm run build -w @rally/contracts",
    "dev": "expo start --localhost --dev-client",
    "prestart": "npm run build -w @rally/contracts",
    "start": "expo start --localhost --dev-client",
    "storybook": "node ./scripts/storybook-local.mjs",
    "test:storybook": "node --test scripts/storybook-env.test.mjs scripts/storybook-local.test.mjs && vitest run .rnstorybook",
    "check:fingerprint-env": "node ./scripts/check-fingerprint-env.mjs",
    "preupdate:preview": "node ./scripts/check-fingerprint-env.mjs",
    "update:preview": "EXPO_NO_METRO_WORKSPACE_ROOT=1 EXPO_PUBLIC_ENABLE_RUNNING_GPS=true npx eas-cli update --branch preview --environment production",
    "preupdate:alpha": "node ./scripts/check-fingerprint-env.mjs && node ./scripts/check-alpha-release.mjs --mode update",
    "check:alpha-build": "node ./scripts/check-alpha-release.mjs --mode prebuild",
    "check:alpha-release": "node ./scripts/check-alpha-release.mjs --mode update",
    "update:alpha": "EXPO_NO_METRO_WORKSPACE_ROOT=1 EXPO_PUBLIC_ENABLE_RUNNING_GPS=true npx eas-cli update --branch alpha --environment production",
    "env:staging": "cp .env.staging .env && echo '-> local backend = STAGING (xovofmkyzyqjxvmvogsw)'",
    "env:prod": "cp .env.production .env && echo '-> local backend = PRODUCTION Singapore (ltrdptqotnioajnlesqy)'",
    "env:which": "grep EXPO_PUBLIC_SUPABASE_URL .env",
    "reset-project": "node ./scripts/reset-project.js",
    "android:dev": "node ./scripts/android-emulator-dev.mjs --restart-metro",
    "android:server": "node ./scripts/android-emulator-dev.mjs --restart-metro --no-launch",
    "preios": "npm run build -w @rally/contracts",
    "ios": "node ./scripts/ios-simulator-dev.mjs --device 'Rally iPhone 12 B'",
    "preios:build": "npm run build -w @rally/contracts",
    "ios:build": "expo run:ios --device 'Rally iPhone 12 B'",
    "preios:server": "npm run build -w @rally/contracts",
    "ios:server": "node ./scripts/ios-simulator-dev.mjs --no-launch",
    "preios:test": "npm run build -w @rally/contracts",
    "ios:test": "node ./scripts/ios-simulator-dev.mjs --device 'Rally iPhone 12 A' --device 'Rally iPhone 12 B'",
    "preios:full": "npm run build -w @rally/contracts",
    "ios:full": "node ./scripts/ios-simulator-dev.mjs --device 'Rally iPhone 16 Pro DI'",
    "preweb": "npm run build -w @rally/contracts",
    "web": "expo start --web",
    "admin:cleanup-smoke": "node ./scripts/cleanup-smoke-tests.js",
    "prelint": "npm run build -w @rally/contracts",
    "lint": "expo lint",
    "pretypecheck": "npm run build -w @rally/db-types && npm run build -w @rally/contracts && expo customize tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:storybook": "tsc -p .rnstorybook/tsconfig.json --noEmit",
    "pretest": "npm run build -w @rally/contracts",
    "test": "vitest run",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "mock-api": "json-server --port 4000 --host 0.0.0.0 ./mocks/leaderboard-db.json",
    "export:page-html": "node ./scripts/export-page-html.mjs",
    "export:page-html:offline": "node ./scripts/export-page-html.mjs --offline"
  },
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-thai": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/prompt": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^14.0.0",
    "@maplibre/maplibre-react-native": "^11.0.2",
    "@rally/contracts": "*",
    "@rally/db-types": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.103.3",
    "@tanstack/react-query": "^5.99.2",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-battery": "~10.0.8",
    "expo-blur": "~15.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.9",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.11",
    "expo-glass-effect": "~0.1.10",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-intent-launcher": "~13.0.8",
    "expo-linking": "~8.0.11",
    "expo-location": "~19.0.8",
    "expo-media-library": "~18.2.1",
    "expo-notifications": "^0.32.16",
    "expo-router": "~6.0.23",
    "expo-screen-recorder": "^0.1.8",
    "expo-secure-store": "~15.0.8",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.10",
    "posthog-react-native": "^4.43.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-health-connect": "^3.5.0",
    "react-native-nitro-modules": "^0.35.6",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.12.1",
    "react-native-view-shot": "4.0.3",
    "react-native-vision-camera": "^4.7.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@gorhom/bottom-sheet": "5.2.14",
    "@playwright/test": "^1.60.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "5.0.1",
    "@storybook/addon-ondevice-actions": "10.4.0",
    "@storybook/addon-ondevice-controls": "10.4.0",
    "@storybook/react": "10.4.0",
    "@storybook/react-native": "10.4.0",
    "@storybook/react-native-theming": "10.4.0",
    "@storybook/react-native-ui": "10.4.0",
    "@storybook/react-native-ui-common": "10.4.0",
    "@types/node": "^25.6.0",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "expo-build-properties": "~1.0.10",
    "expo-health-connect": "^0.1.1",
    "json-server": "^1.0.0-beta.15",
    "storybook": "10.4.0",
    "typescript": "~5.9.2",
    "vitest": "^2.1.9"
  },
  "private": true
}
