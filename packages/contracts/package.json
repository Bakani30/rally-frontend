{
  "name": "@rally/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:deno-analytics": "npm run build && node scripts/generate-deno-analytics.mjs",
    "test": "npm run build && node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@rally/db-types": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
